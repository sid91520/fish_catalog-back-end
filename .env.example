PORT=7001

# Postgres: either a single URL (hosted, SSL on by default)...
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# ...or discrete values (local)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fish_catalog
# DB_SSL=true
# DB_SYNC=false   # set false once you use migrations

# Admin
ADMIN_API_KEY=
# ADMIN_TOKEN_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional, app falls back to DB)
REDIS_ENABLED=true
# REDIS_URL=rediss://default:pass@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_TLS=true

# Comma-separated frontend origins; empty = allow all
CORS_ORIGIN=

# Optional telemetry (module disabled when unset)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
